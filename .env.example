PORT=5000

# Database. Locally use the DB_* values; for Supabase set DATABASE_URL instead
# (Project Settings > Database > Connection string) plus DB_SSL=true.
DB_HOST=localhost
DB_PORT=3000
DB_USERNAME=postgres
DB_PASSWORD=
DB_DATABASE=all-drive
# DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-region.pooler.supabase.com:5432/postgres
# DB_SSL=true
# Supabase CA certificate (Database > SSL Configuration > Download), so the
# server certificate is verified. One line, with \n for line breaks.
# DB_SSL_CA=
# Schema auto-sync is on unless NODE_ENV=production. In production run
# `npm run migration:run` instead. Override with DB_SYNCHRONIZE=true|false.
# NODE_ENV=production

# Auth / JWT
JWT_SECRET=change-me-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=1d

# Default admin, seeded on first boot if no admin exists
ADMIN_EMAIL=admin@alldrive.com
ADMIN_PASSWORD=

# Shared secret the public website (alldrive-website) sends as x-website-key
# when it forwards bookings and inquiries. Must equal ALLDRIVE_API_KEY there.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEBSITE_API_KEY=

# Car photos uploaded in the admin dashboard. With these set (production), photos go to a
# PUBLIC Supabase Storage bucket and get permanent URLs. Without them (local development) they
# are saved in ./uploads, which hosting platforms with temporary disks would lose.
# Supabase: Storage > New bucket (name below, "Public bucket" on). Keys: Project Settings > API.
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=uploads

# Customer emails ("your booking is confirmed", sent when an admin approves a booking), from
# this Gmail account. GMAIL_APP_PASSWORD must be a Google "App password" (16 characters):
# Google Account > Security > 2-Step Verification (on) > App passwords. Same values as the
# website's .env.local. Customer replies go to BOOKING_EMAIL_TO.
GMAIL_USER=alldrivebtc@gmail.com
GMAIL_APP_PASSWORD=
BOOKING_EMAIL_TO=alldrivebtc@gmail.com
# Optional: a different email provider instead of Gmail (uses GMAIL_USER/GMAIL_APP_PASSWORD as
# the login). SMTP_SECURE=true for port 465.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false

# Web push notifications to admins. Generate with: npx web-push generate-vapid-keys
# Keep the private key secret. Changing the keys invalidates every subscription.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for the push services: mailto: or https: URL.
VAPID_SUBJECT=mailto:alldrivebtc@gmail.com
